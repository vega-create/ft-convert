---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import EnergyConverter from '../components/tools/EnergyConverter';
---

<BaseLayout>
  <SEO slot="head" title="Energy Converter" description="Convert between joules, calories, kWh, BTU, and other energy units." />
  <script slot="head" type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How many calories are in a kilojoule?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One kilocalorie (food calorie) equals approximately 4.184 kilojoules.\"}},{\"@type\":\"Question\",\"name\":\"What is a BTU?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A British Thermal Unit is the energy needed to raise one pound of water by one degree Fahrenheit, equal to about 1,055 joules.\"}}]}"} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">Energy Converter</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-6">Energy Converter</h1>

    <EnergyConverter client:load />

    <AdSense slot="middle" />

    <div class="mt-12 prose prose-gray max-w-none">
      <h2>How to Convert Energy Units</h2><p>Energy conversion is used in nutrition (calories), electricity (kWh), heating (BTU), and physics (joules). Understanding these conversions helps with diet planning, understanding energy bills, and scientific calculations.</p>
    </div>

    <div class="mt-12 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4">
      <div class="border-b border-gray-100 pb-4 last:border-0">
        <h3 class="font-semibold text-gray-900 mb-2">How many calories are in a kilojoule?</h3>
        <p class="text-gray-600">One kilocalorie (food calorie) equals approximately 4.184 kilojoules.</p>
      </div>
      <div class="border-b border-gray-100 pb-4 last:border-0">
        <h3 class="font-semibold text-gray-900 mb-2">What is a BTU?</h3>
        <p class="text-gray-600">A British Thermal Unit is the energy needed to raise one pound of water by one degree Fahrenheit, equal to about 1,055 joules.</p>
      </div>
      </div>
    </div>

    <AdSense slot="bottom" />
  </div>
</BaseLayout>
