---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import TemperatureConverter from '../components/tools/TemperatureConverter';
---

<BaseLayout>
  <SEO slot="head" title="Temperature Converter" description="Convert between Celsius, Fahrenheit, and Kelvin temperature scales instantly." />
  <script slot="head" type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the formula for Celsius to Fahrenheit?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Multiply Celsius by 9/5 and add 32: °F = (°C × 9/5) + 32.\"}},{\"@type\":\"Question\",\"name\":\"What is absolute zero?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Absolute zero is 0 Kelvin (-273.15°C or -459.67°F), the lowest possible temperature.\"}}]}"} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">Temperature Converter</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-6">Temperature Converter</h1>

    <TemperatureConverter client:load />

    <AdSense slot="middle" />

    <div class="mt-12 prose prose-gray max-w-none">
      <h2>How to Convert Temperature</h2><p>Temperature conversion is needed when traveling between countries using different scales, following cooking recipes, or working with scientific data.</p><h3>The Three Main Scales</h3><p>Celsius is used by most of the world, Fahrenheit is used primarily in the US, and Kelvin is used in scientific contexts. Water freezes at 0°C (32°F, 273.15K) and boils at 100°C (212°F, 373.15K).</p>
    </div>

    <div class="mt-12 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4">
      <div class="border-b border-gray-100 pb-4 last:border-0">
        <h3 class="font-semibold text-gray-900 mb-2">What is the formula for Celsius to Fahrenheit?</h3>
        <p class="text-gray-600">Multiply Celsius by 9/5 and add 32: °F = (°C × 9/5) + 32.</p>
      </div>
      <div class="border-b border-gray-100 pb-4 last:border-0">
        <h3 class="font-semibold text-gray-900 mb-2">What is absolute zero?</h3>
        <p class="text-gray-600">Absolute zero is 0 Kelvin (-273.15°C or -459.67°F), the lowest possible temperature.</p>
      </div>
      </div>
    </div>

    <AdSense slot="bottom" />
  </div>
</BaseLayout>
