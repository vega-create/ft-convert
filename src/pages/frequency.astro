---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import FrequencyConverter from '../components/tools/FrequencyConverter';
---

<BaseLayout>
  <SEO slot="head" title="Frequency Converter" description="Convert between Hz, kHz, MHz, GHz, and RPM frequency units." />
  <script slot="head" type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is a Hertz?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One Hertz equals one cycle per second. It is the SI unit of frequency, named after physicist Heinrich Hertz.\"}}]}"} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">Frequency Converter</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-6">Frequency Converter</h1>

    <FrequencyConverter client:load />

    <AdSense slot="middle" />

    <div class="mt-12 prose prose-gray max-w-none">
      <h2>How to Convert Frequency Units</h2><p>Frequency conversion is used in electronics, radio communications, computing, and music. Frequency measures how many cycles occur per second, measured in Hertz (Hz).</p>
    </div>

    <div class="mt-12 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4">
      <div class="border-b border-gray-100 pb-4 last:border-0">
        <h3 class="font-semibold text-gray-900 mb-2">What is a Hertz?</h3>
        <p class="text-gray-600">One Hertz equals one cycle per second. It is the SI unit of frequency, named after physicist Heinrich Hertz.</p>
      </div>
      </div>
    </div>

    <AdSense slot="bottom" />
  </div>
</BaseLayout>
