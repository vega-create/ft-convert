---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import AreaConverter from '../components/tools/AreaConverter';
---

<BaseLayout>
  <SEO slot="head" title="Area Converter" description="Convert between square meters, square feet, acres, hectares, and more area units." />
  <script slot="head" type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How many square feet are in an acre?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One acre equals 43,560 square feet.\"}},{\"@type\":\"Question\",\"name\":\"What is a hectare?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A hectare is 10,000 square meters, commonly used for measuring land area. It equals about 2.471 acres.\"}}]}"} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">Area Converter</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-6">Area Converter</h1>

    <AreaConverter client:load />

    <AdSense slot="middle" />

    <div class="mt-12 prose prose-gray max-w-none">
      <h2>How to Convert Area Units</h2><p>Area conversion is essential for real estate, land measurement, construction, and interior design. Understanding the relationship between metric and imperial area units helps when comparing property sizes internationally.</p><h3>Common Conversions</h3><p>1 square meter equals about 10.764 square feet. For land, 1 acre equals approximately 4,047 square meters or 0.405 hectares. 1 hectare equals 10,000 square meters or about 2.471 acres.</p>
    </div>

    <div class="mt-12 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4">
      <div class="border-b border-gray-100 pb-4 last:border-0">
        <h3 class="font-semibold text-gray-900 mb-2">How many square feet are in an acre?</h3>
        <p class="text-gray-600">One acre equals 43,560 square feet.</p>
      </div>
      <div class="border-b border-gray-100 pb-4 last:border-0">
        <h3 class="font-semibold text-gray-900 mb-2">What is a hectare?</h3>
        <p class="text-gray-600">A hectare is 10,000 square meters, commonly used for measuring land area. It equals about 2.471 acres.</p>
      </div>
      </div>
    </div>

    <AdSense slot="bottom" />
  </div>
</BaseLayout>
